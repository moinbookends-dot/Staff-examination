# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — secrets never committed; the template is
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# supabase local artefacts
supabase/.temp/
supabase/.branches/

# playwright
/test-results/
/playwright-report/

# ── PDF spikes and rendered samples ──────────────────────────────────────────
#
# scripts/pdf-sample.test.ts and scripts/pdf-to-png.mjs write real PDFs and
# PNGs here so a person can LOOK at a generated paper. Three separate footer
# bugs were found that way, each of which produced a perfectly valid PDF and
# was invisible to every text assertion — so the tooling earns its place, but
# its output is regenerated on demand and is never worth committing.
scripts/.spike/

# ── Source documents ─────────────────────────────────────────────────────────
#
# Cookbooks and other imported source material never belong in the repository.
# They are proprietary, they are large — the two that were briefly committed
# here totalled 115 MB — and this repository is public.
#
# From M11 they live in Supabase Storage, which gives them RLS, versioning and
# signed URLs. Git gives them none of those and keeps them forever.
assets/*.pdf
assets/*.docx
assets/*.xlsx

# The same rule, one step downstream. scripts/parse-aiko*.mjs turn a supplied
# question set into these intermediates — 2,053 questions with their answer
# keys, roughly 1 MB — and scripts/import-aiko.mjs loads them into the bank.
# They are derived from proprietary material and the answer keys are the whole
# product, so a public repository is the last place they belong. Regenerate
# them from the source document when an import needs re-running.
_aiko*.json

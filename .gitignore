# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — secrets never committed; the template is
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# supabase local artefacts
supabase/.temp/
supabase/.branches/

# playwright
/test-results/
/playwright-report/

# ── Source documents ─────────────────────────────────────────────────────────
#
# Cookbooks and other imported source material never belong in the repository.
# They are proprietary, they are large — the two that were briefly committed
# here totalled 115 MB — and this repository is public.
#
# From M11 they live in Supabase Storage, which gives them RLS, versioning and
# signed URLs. Git gives them none of those and keeps them forever.
assets/*.pdf
assets/*.docx
assets/*.xlsx

# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env.local and fill in. .env.local is gitignored — never commit it.
# Values: Supabase Dashboard → Project Settings → API Keys.
#
# This project uses Supabase's NEW API key format (sb_publishable_ / sb_secret_),
# NOT the legacy anon / service_role JWTs. Stay on the "Publishable and secret
# API keys" tab; ignore the "Legacy anon, service_role API keys" tab.
#
# Unlike legacy JWT keys, these are opaque strings sent only in the `apikey`
# header — never as `Authorization: Bearer`. That leaves the Authorization
# header for the user's access token, which is what auth.jwt() reads in RLS.
# ─────────────────────────────────────────────────────────────────────────────

# PUBLIC — compiled into the browser bundle. Not secret by design; every visitor
# has these. Row-Level Security is what protects the data, not obscurity.
NEXT_PUBLIC_SUPABASE_URL= 
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SECRET — bypasses RLS entirely. Full read/write on every table.
# Server-only: read exclusively by src/lib/supabase/admin.ts.
# Must NEVER be prefixed NEXT_PUBLIC_ and never imported into a client component.
# Revocable and rotatable independently — rotate immediately if ever exposed.
SUPABASE_SECRET_KEY=

# SECRET — CLI only, not read by the app. Set these in your shell environment
# (not just this file) so `supabase link` and `supabase db push` run without
# an interactive password prompt.
#   SUPABASE_ACCESS_TOKEN : Account → Access Tokens → generate new (sbp_…)
#   SUPABASE_DB_PASSWORD  : the database password set when the project was created
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=

# Project ref — the subdomain in NEXT_PUBLIC_SUPABASE_URL
# (https://<ref>.supabase.co). Used by `supabase link --project-ref`.
SUPABASE_PROJECT_REF=

# ── Added in later milestones ────────────────────────────────────────────────
# RESEND_API_KEY=          # M8 — transactional email
# GEMINI_API_KEY=          # Phase 3 — AI features
# SENTRY_DSN=              # M0 — error telemetry
